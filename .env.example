FOUNDRY_PROJECT_ENDPOINT=https://ssc-foundery.services.ai.azure.com/api/projects/ssc-proj-default
FOUNDRY_MODEL=gpt-5.3-codex

# Podman-backed DockerShellTool integration. The Compose service uses the
# rootless Podman API socket from the local Podman machine.
DOCKER_SHELL_ENABLED=true
DOCKER_SHELL_IMAGE=mcr.microsoft.com/dotnet/sdk:8.0
DOCKER_SHELL_MODE=stateless
DOCKER_SHELL_BINARY=podman
DOCKER_SHELL_TIMEOUT=30
# Optional host directory mounted read-only at DOCKER_SHELL_WORKDIR.
DOCKER_SHELL_HOST_WORKDIR=
DOCKER_SHELL_WORKDIR=/tmp
# On macOS with Podman machine, use the Linux path inside the machine:
# podman machine ssh podman-machine-default 'id -u; id -g'
PODMAN_SOCKET_PATH=/run/user/603526487/podman/podman.sock
PODMAN_MACHINE_GID=1000
PODMAN_CONTAINER_HOST=unix:///run/podman/podman.sock

# Microsoft Entra ID / MSAL frontend configuration. These IDs are public SPA configuration.
VITE_MSAL_TENANT_ID=505cca53-5750-4134-9501-8d52d5df3cd1
VITE_MSAL_CLIENT_ID=74ecbe9f-2767-4fc9-848d-c2232cf1311a

# Temporary development mode: the backend accepts any valid signed token
# issued by this tenant, without requiring an API resource or scope.
MSAL_TENANT_ID=505cca53-5750-4134-9501-8d52d5df3cd1

# Used by the Python backend's DefaultAzureCredential chain when service
# principal authentication is needed.
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=

# Durable conversational memory used by both Agent Framework profiles.
COGNEE_ENABLED=true
COGNEE_URL=http://localhost:8000
# Optional X-Api-Key for authenticated Cognee deployments.
COGNEE_API_KEY=
COGNEE_DATASET=ssc_agent_memory
COGNEE_TIMEOUT=10
COGNEE_TOP_K=5
# Local Compose defaults to single-user mode. Enable for authenticated deployments.
COGNEE_ENABLE_BACKEND_ACCESS_CONTROL=false

# Cognee uses Azure Foundry for generation and embeddings with an API key. The resource-level
# endpoint is required by Cognee; the project endpoint above is used by the
# Python backend.
LLM_PROVIDER=azure
LLM_MODEL=azure/gpt-4.1-mini
LLM_ENDPOINT=https://ssc-foundery.services.ai.azure.com
LLM_API_VERSION=2024-12-01-preview
# Azure resource key used by Cognee for chat completions.
LLM_API_KEY=
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=azure/text-embedding-3-small
EMBEDDING_ENDPOINT=https://ssc-foundery.services.ai.azure.com/openai/deployments/text-embedding-3-small
EMBEDDING_API_VERSION=2024-12-01-preview
# Use the same Azure resource key for embeddings.
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=1536

# PostgreSQL credentials used by both the postgres container and Cognee.
POSTGRES_USER=cognee
POSTGRES_PASSWORD=change-me-for-local-use
POSTGRES_DB=cognee_db

# Host ports. Change these when another local service uses the defaults.
SSC_AGENT_PORT=8080
COGNEE_PORT=8000
POSTGRES_PORT=5432
